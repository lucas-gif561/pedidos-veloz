# Copie para .env (que está no .gitignore) se quiser sobrescrever os defaults de DEV.
# NUNCA faça commit de senhas reais.
POSTGRES_PASSWORD=postgres_dev
ORDERS_DB_PASSWORD=orders_dev
INVENTORY_DB_PASSWORD=inventory_dev
GRAFANA_ADMIN_PASSWORD=admin_dev

LOG_LEVEL=info
# true desliga o envio de traces
OTEL_SDK_DISABLED=false

# Simulação do provedor de pagamento
PAYMENT_LATENCY_MS=150
PAYMENT_FAILURE_RATE=0.05

# Tag/registry das imagens geradas pelo build local
TAG=dev
REGISTRY=pedidos-veloz
